# Copy to .env.local and fill in. NEVER commit .env.local.

# --- App security -----------------------------------------------------------
# Generate with: npm run hash-password -- "your-password"
APP_PASSWORD_HASH=
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# 32 random bytes, base64 — encrypts provider tokens/API keys at rest (AES-256-GCM).
ENCRYPTION_KEY=

# Public base URL of this app (used for the OAuth redirect URI).
APP_BASE_URL=http://localhost:3000

# Your home time zone (IANA). Used to bucket Hevy workouts (UTC only) into days.
HOME_TIME_ZONE=Europe/Brussels

# --- Database -----------------------------------------------------------------
DATABASE_PATH=./data/health.db

# --- Google Health API (OAuth 2.0 "Web application" client) -------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must also be registered in Google Cloud Console → Credentials → Authorized redirect URIs:
#   ${APP_BASE_URL}/api/auth/google/callback

# --- Hevy (requires Hevy Pro; key from https://hevy.com/settings?developer) ----
# Optional here: you can also paste the key in Settings → Connections (stored encrypted).
HEVY_API_KEY=

# --- Development only ----------------------------------------------------------
# DEMO_MODE=1 uses ./data/demo.db with clearly-labelled FICTIONAL data. Refused in production.
DEMO_MODE=
