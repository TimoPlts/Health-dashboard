{
  "name": "baseline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Baseline — private, single-user health & training app for Google Health (Fitbit Air) data.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3001",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "service": "tsx scripts/service.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "probe:google": "tsx scripts/probe-google.ts",
    "verify:google": "tsx scripts/verify-google.ts",
    "check:analytics": "tsx scripts/check-analytics.ts",
    "probe:hevy": "tsx scripts/probe-hevy.ts",
    "sync": "tsx scripts/sync.ts",
    "configure": "tsx scripts/configure.ts",
    "backup": "tsx scripts/data.ts backup",
    "data": "tsx scripts/data.ts",
    "predev": "tsx scripts/configure.ts init"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
